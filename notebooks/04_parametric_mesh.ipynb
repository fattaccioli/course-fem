   "source": [
    "---\n",
    "## Example 3: T-Junction Mixer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_t_junction(L_main, H_main, L_branch, H_branch, lc):\n",
    "    \"\"\"Create a T-junction for mixing.\n",
    "    \n",
    "    Main channel: horizontal\n",
    "    Branch channel: perpendicular at center\n",
    "    \"\"\"\n",
    "    \n",
    "    gmsh.initialize()\n",
    "    gmsh.model.add(\"t_junction\")\n",
    "    \n",
    "    # Main channel (horizontal)\n",
    "    gmsh.model.geo.addPoint(0,        -H_main/2, 0, lc, 1)\n",
    "    gmsh.model.geo.addPoint(L_main,   -H_main/2, 0, lc, 2)\n",
    "    gmsh.model.geo.addPoint(L_main,    H_main/2, 0, lc, 3)\n",
    "    gmsh.model.geo.addPoint(0,         H_main/2, 0, lc, 4)\n",
    "    \n",
    "    # Branch channel (vertical, at x = L_main/2)\n",
    "    x_branch = L_main / 2\n",
    "    gmsh.model.geo.addPoint(x_branch,  H_main/2,           0, lc, 5)  # junction top\n",
    "    gmsh.model.geo.addPoint(x_branch,  H_main/2 + H_branch, 0, lc, 6)  # branch top\n",
    "    gmsh.model.geo.addPoint(x_branch + H_branch/2, H_main/2 + H_branch, 0, lc, 7)  # branch right\n",
    "    gmsh.model.geo.addPoint(x_branch + H_branch/2, H_main/2, 0, lc, 8)  # junction right\n",
    "    \n",
    "    # Lines\n",
    "    gmsh.model.geo.addLine(1, 2, 1)  # main bottom left\n",
    "    gmsh.model.geo.addLine(2, 3, 2)  # right\n",
    "    gmsh.model.geo.addLine(3, 8, 3)  # top right\n",
    "    gmsh.model.geo.addLine(8, 7, 4)  # branch right\n",
    "    gmsh.model.geo.addLine(7, 6, 5)  # branch top\n",
    "    gmsh.model.geo.addLine(6, 5, 6)  # branch left\n",
    "    gmsh.model.geo.addLine(5, 4, 7)  # top left\n",
    "    gmsh.model.geo.addLine(4, 1, 8)  # left\n",
    "    \n",
    "    # Surface\n",
    "    gmsh.model.geo.addCurveLoop([1, 2, 3, 4, 5, 6, 7, 8], 1)\n",
    "    gmsh.model.geo.addPlaneSurface([1], 1)\n",
    "    \n",
    "    # Mesh & save\n",
    "    gmsh.model.geo.synchronize()\n",
    "    gmsh.model.mesh.generate(2)\n",
    "    gmsh.model.mesh.setOrder(2)\n",
    "    gmsh.write(\"/tmp/t_junction.msh\")\n",
    "    gmsh.finalize()\n",
    "    \n",
    "    print(\"T-junction mesh created.\")\n",
    "\n",
    "create_t_junction(L_main=0.6, H_main=0.1, L_branch=0.15, H_branch=0.08, lc=0.01)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Key Takeaways\n",
    "\n",
    "**gmsh Python API:**\n",
    "- `addPoint()` → define geometry\n",
    "- `addLine()` → connect points\n",
    "- `addCurveLoop()` → close boundary\n",
    "- `addPlaneSurface()` → fill region\n",
    "- `addPhysicalGroup()` → tag for FEniCS\n",
    "- `generate(2)` → mesh\n",
    "- `write()` → save\n",
    "\n",
    "**Parametric Design:**\n",
    "- All dimensions are variables (L, H, etc.)\n",
    "- Change parameters → remesh automatically\n",
    "- Perfect for sensitivity studies\n",
    "\n",
    "**Next:** Notebook 4.2 uses these meshes with FEniCS"
   ]
  }
