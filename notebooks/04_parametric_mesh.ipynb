   "source": [
    "# Notebook 4.1: Parametric Mesh Generation with gmsh\n",
    "\n",
    "## Objective\n",
    "Learn to create **parametric geometries** in gmsh using Python scripting.\n",
    "\n",
    "**Key Skills:**\n",
    "- Define points and lines programmatically\n",
    "- Create surfaces and tag physical regions\n",
    "- Control mesh density with local refinement\n",
    "- Export to format FEniCS can read\n",
    "\n",
    "**Applications:**\n",
    "- Design T-mixers, Y-junctions, constrictions\n",
    "- Parametric design → automatic mesh generation\n",
    "- Workflow: Vary geometry parameters → remesh → simulate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import gmsh\n",
    "import numpy as np\n",
    "import os\n",
    "\n",
    "print(f\"gmsh version: {gmsh.GMSH_API_VERSION}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Example 1: Simple Rectangular Channel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_channel(L, H, lc, filename=\"channel.msh\"):\n    "    \"\"\"Create a simple rectangular channel mesh.\n",
    "    \n",
    "    Parameters:\n",
    "      L: channel length\n",
    "      H: channel height\n",
    "      lc: characteristic length (mesh density)\n",
    "      filename: output mesh file\n",
    "    \"\"\"\n",
    "    \n",
    "    gmsh.initialize()\n",
    "    gmsh.model.add(\"channel\")\n",
    "    \n",
    "    # Add points (corners)\n",
    "    gmsh.model.geo.addPoint(0,   -H/2, 0, lc, 1)  # bottom-left\n",
    "    gmsh.model.geo.addPoint(L,   -H/2, 0, lc, 2)  # bottom-right\n",
    "    gmsh.model.geo.addPoint(L,    H/2, 0, lc, 3)  # top-right\n",
    "    gmsh.model.geo.addPoint(0,    H/2, 0, lc, 4)  # top-left\n",
    "    \n",
    "    # Add lines\n",
    "    gmsh.model.geo.addLine(1, 2, 1)  # bottom\n",
    "    gmsh.model.geo.addLine(2, 3, 2)  # right\n",
    "    gmsh.model.geo.addLine(3, 4, 3)  # top\n",
    "    gmsh.model.geo.addLine(4, 1, 4)  # left\n",
    "    \n",
    "    # Add curve loop and surface\n",
    "    gmsh.model.geo.addCurveLoop([1, 2, 3, 4], 1)\n",
    "    gmsh.model.geo.addPlaneSurface([1], 1)\n",
    "    \n",
    "    # Tag physical regions\n",
    "    gmsh.model.addPhysicalGroup(1, [4], name=\"inlet\")\n",
    "    gmsh.model.addPhysicalGroup(1, [2], name=\"outlet\")\n",
    "    gmsh.model.addPhysicalGroup(1, [1, 3], name=\"walls\")\n",
    "    gmsh.model.addPhysicalGroup(2, [1], name=\"fluid\")\n",
    "    \n",
    "    # Generate mesh\n",
    "    gmsh.model.geo.synchronize()\n",
    "    gmsh.model.mesh.generate(2)\n",
    "    gmsh.model.mesh.setOrder(2)  # Second-order elements\n",
    "    \n",
    "    # Write mesh file\n",
    "    gmsh.write(filename)\n",
    "    gmsh.finalize()\n",
    "    \n",
    "    print(f\"Mesh saved to {filename}\")\n",
    "\n",
    "# Create a mesh\n",
    "create_channel(L=1.0, H=0.1, lc=0.02, filename=\"/tmp/channel.msh\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Example 2: Channel with Constriction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_constricted_channel(L_up, L_con, L_down, H, H_min, lc):\n",
    "    \"\"\"Create a channel with a constriction.\n",
    "    \n",
    "    Geometry:\n",
    "      - Upstream: width H\n",
    "      - Constriction: width H_min\n",
    "      - Downstream: width H\n",
    "    \"\"\"\n",
    "    \n",
    "    gmsh.initialize()\n",
    "    gmsh.model.add(\"constricted_channel\")\n",
    "    \n",
    "    # Upstream section\n",
    "    gmsh.model.geo.addPoint(0,        -H/2,    0, lc, 1)\n",
    "    gmsh.model.geo.addPoint(L_up,     -H/2,    0, lc, 2)\n",
    "    gmsh.model.geo.addPoint(L_up,      H/2,    0, lc, 3)\n",
    "    gmsh.model.geo.addPoint(0,         H/2,    0, lc, 4)\n",
    "    \n",
    "    # Constriction section\n",
    "    gmsh.model.geo.addPoint(L_up + L_con, -H_min/2, 0, lc, 5)\n",
    "    gmsh.model.geo.addPoint(L_up + L_con,  H_min/2, 0, lc, 6)\n",
    "    \n",
    "    # Downstream section\n",
    "    gmsh.model.geo.addPoint(L_up + L_con + L_down, -H/2, 0, lc, 7)\n",
    "    gmsh.model.geo.addPoint(L_up + L_con + L_down,  H/2, 0, lc, 8)\n",
    "    \n",
    "    # Lines\n",
    "    gmsh.model.geo.addLine(1, 2, 1)   # upstream bottom\n",
    "    gmsh.model.geo.addLine(2, 5, 2)   # constriction bottom\n",
    "    gmsh.model.geo.addLine(5, 7, 3)   # downstream bottom\n",
    "    gmsh.model.geo.addLine(7, 8, 4)   # downstream right\n",
    "    gmsh.model.geo.addLine(8, 6, 5)   # downstream top\n",
    "    gmsh.model.geo.addLine(6, 3, 6)   # constriction top\n",
    "    gmsh.model.geo.addLine(3, 4, 7)   # upstream top\n",
    "    gmsh.model.geo.addLine(4, 1, 8)   # upstream left\n",
    "    \n",
    "    # Loop and surface\n",
    "    gmsh.model.geo.addCurveLoop([1, 2, 3, 4, 5, 6, 7, 8], 1)\n",
    "    gmsh.model.geo.addPlaneSurface([1], 1)\n",
    "    \n",
    "    # Physical tags\n",
    "    gmsh.model.addPhysicalGroup(1, [8], name=\"inlet\")\n",
    "    gmsh.model.addPhysicalGroup(1, [4], name=\"outlet\")\n",
    "    gmsh.model.addPhysicalGroup(1, [1, 2, 3, 5, 6, 7], name=\"walls\")\n",
    "    gmsh.model.addPhysicalGroup(2, [1], name=\"fluid\")\n",
    "    \n",
    "    # Mesh\n",
    "    gmsh.model.geo.synchronize()\n",
    "    gmsh.model.mesh.generate(2)\n",
    "    gmsh.model.mesh.setOrder(2)\n",
    "    \n",
    "    gmsh.write(\"/tmp/constricted_channel.msh\")\n",
    "    gmsh.finalize()\n",
    "    \n",
    "    print(\"Constricted channel mesh created.\")\n",
    "\n",
    "create_constricted_channel(L_up=0.3, L_con=0.1, L_down=0.3, H=0.1, H_min=0.05, lc=0.02)"
   ]
  },
